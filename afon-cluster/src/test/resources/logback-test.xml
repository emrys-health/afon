<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%yellow(%date{ISO8601}) | %highlight(%level) | %cyan(%logger{36}) - %highlight(%msg%n%ex{full})</pattern>
    </encoder>
  </appender>

  <root level="DEBUG" additivity="false">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="org.apache.hc.client5" level="WARN"/>
  <logger name="org.apache.iceberg" level="WARN"/>
  <logger name="org.apache.spark" level="WARN"/>
  <logger name="org.apache.hadoop" level="WARN"/>
  <logger name="io.netty" level="WARN"/>
  <logger name="org.sparkproject.jetty" level="WARN"/>
  <logger name="net.snowflake" level="ERROR"/>
  <logger name="net.snowflake.client.jdbc.RestRequest" level="FATAL"/>
</configuration>
