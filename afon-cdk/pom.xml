<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>health.emrys.afon</groupId>
        <artifactId>afon</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>afon-cdk</artifactId>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-theme</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>${classgraph.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-polaris</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-spark</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-snowflake</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-trino</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eks</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf</artifactId>
            <version>0.21.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-aws</artifactId>
            <version>21.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-google</artifactId>
            <version>16.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-azurerm</artifactId>
            <version>14.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-kubernetes</artifactId>
            <version>12.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-helm</artifactId>
            <version>12.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.hashicorp</groupId>
            <artifactId>cdktf-provider-null</artifactId>
            <version>11.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- charts/*.tgz are vendored binaries and must never pass through filtering. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>versions.properties</exclude>
                </excludes>
            </resource>
            <!-- versions.properties is the only resource filtered, so ${polaris.version} above
                 is resolved into the jar as the single source of truth DockerImages reads at
                 runtime - see DockerImages.POLARIS_IMAGE. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>versions.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- The unit tests define their stacks in a test file, so as not to depend on the stacks.yaml in
                     the config dir, which the smoke and acceptance tests rely on. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <afon.stacks>${project.basedir}/src/test/resources/stacks-test.yaml</afon.stacks>
                        <afon.docker-images>bundled</afon.docker-images>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>