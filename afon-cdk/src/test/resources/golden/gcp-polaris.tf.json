    "kubernetes_job_v1" : {
      "polaris_polarisDbInitJob_7644F16B" : {
        "//" : {
          "metadata" : {
            "path" : "gcp-polaris/polaris/polarisDbInitJob",
            "uniqueId" : "polaris_polarisDbInitJob_7644F16B"
          }
        },
        "depends_on" : [ "google_container_cluster.gcp_gkeCluster_57353C4A" ],
        "metadata" : {
          "name" : "polaris-db-init",
          "namespace" : "default"
        },
        "spec" : {
          "backoff_limit" : 6,
          "template" : {
            "metadata" : {
              "labels" : {
                "app" : "polaris-db-init"
              }
            },
            "spec" : {
              "container" : [ {
                "command" : [ "sh", "-c", "set -e\nif [ -f /state/already-bootstrapped ]; then\n  echo 'Polaris realm POLARIS already bootstrapped, skipping'\n  exit 0\nfi\njava -jar /deployments/polaris-admin-tool.jar bootstrap -r POLARIS -c \"POLARIS,$POLARIS_ID,$POLARIS_SECRET\"" ],
                "env" : [ {
                  "name" : "POLARIS_PERSISTENCE_TYPE",
                  "value" : "relational-jdbc"
                }, {
                  "name" : "QUARKUS_DATASOURCE_JDBC_URL",
                  "value" : "jdbc:postgresql://golden-polaris-db-host:5432/polaris_db_polaris-gcp_golden_example"
                }, {
                  "name" : "QUARKUS_DATASOURCE_USERNAME",
                  "value" : "postgres"
                }, {
                  "name" : "QUARKUS_DATASOURCE_PASSWORD",
                  "value" : "golden-polaris-db-password"
                }, {
                  "name" : "POLARIS_ID",
                  "value" : "golden-polaris-id"
                }, {
                  "name" : "POLARIS_SECRET",
                  "value" : "golden-polaris-secret"
                } ],
                "image" : "apache/polaris-admin-tool:1.6.0",
                "name" : "bootstrap",
                "volume_mount" : [ {
                  "mount_path" : "/state",
                  "name" : "state",
                  "read_only" : true
                } ]
              } ],
              "init_container" : [ {
                "command" : [ "sh", "-c", "set -e\nuntil pg_isready -h \"$PGHOST\" -p \"$PGPORT\" -U \"$PGUSER\"; do echo 'waiting for postgres'; sleep 2; done\npsql -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname='$POLARIS_DB'\" | grep -q 1 \\\n  || psql -d postgres -c \"CREATE DATABASE \\\"$POLARIS_DB\\\"\"\nif [ \"$(psql -d \"$POLARIS_DB\" -tAc \"SELECT to_regclass('polaris_schema.entities')\")\" = 'polaris_schema.entities' ]; then\n  touch /state/already-bootstrapped\nfi\necho 'polaris db ready'" ],
                "env" : [ {
                  "name" : "PGHOST",
                  "value" : "golden-polaris-db-host"
                }, {
                  "name" : "PGPORT",
                  "value" : "5432"
                }, {
                  "name" : "PGUSER",
                  "value" : "postgres"
                }, {
                  "name" : "PGPASSWORD",
                  "value" : "golden-polaris-db-password"
                }, {
                  "name" : "POLARIS_DB",
                  "value" : "polaris_db_polaris-gcp_golden_example"
                } ],
                "image" : "postgres:16-alpine",
                "name" : "db-create",
                "volume_mount" : [ {
                  "mount_path" : "/state",
                  "name" : "state"
                } ]
              } ],
              "restart_policy" : "OnFailure",
              "volume" : [ {
                "empty_dir" : { },
                "name" : "state"
              } ]
            }
          }
        },
        "timeouts" : {
          "create" : "10m"
        }
