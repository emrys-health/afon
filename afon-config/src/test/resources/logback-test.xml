<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <property name="CONSOLE_LEVEL" value="${afon.logging.console:-OFF}" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${CONSOLE_LEVEL}</level>
    </filter>
    <encoder>
      <pattern>%yellow(%date{ISO8601}) | %highlight(%level) | %cyan(%logger{36}) - %highlight(%msg%n%ex{full})</pattern>
    </encoder>
  </appender>

  <root level="${CONSOLE_LEVEL}">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="health.emrys.afon.config" level="${CONSOLE_LEVEL}"/>
  <logger name="org.apache.hc.client5" level="${CONSOLE_LEVEL}"/>
  <logger name="org.apache.iceberg" level="${CONSOLE_LEVEL}"/>
  <logger name="org.apache.spark" level="${CONSOLE_LEVEL}"/>
  <logger name="org.apache.hadoop" level="${CONSOLE_LEVEL}"/>
  <logger name="io.netty" level="${CONSOLE_LEVEL}"/>
  <logger name="org.sparkproject.jetty" level="${CONSOLE_LEVEL}"/>
  <logger name="net.snowflake" level="${CONSOLE_LEVEL}"/>
  <logger name="net.snowflake.client.jdbc.RestRequest" level="${CONSOLE_LEVEL}"/>
</configuration>
