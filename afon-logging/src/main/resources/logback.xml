<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

  <property name="DIR" value="${afon.home:-../}/logs" />
  <property name="LEVEL" value="${afon.logging:-INFO}" />
  <!-- The console is filtered out entirely by default, logging to file only.
       Set it via -Dafon.logging.console to have logging to console as well.
  -->
  <property name="CONSOLE_LEVEL" value="${afon.logging.console:-OFF}" />

  <appender name="FILE_CORE" class="ch.qos.logback.core.FileAppender">
    <file>${DIR}/afon-core.log</file>
    <append>true</append>
    <encoder>
      <pattern>%yellow(%date{ISO8601}) | %highlight(%level) | %cyan(%logger{36}) - %highlight(%msg%n%ex{full})</pattern>
    </encoder>
  </appender>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${CONSOLE_LEVEL}</level>
    </filter>
    <encoder>
      <pattern>%yellow(%date{ISO8601}) | %highlight(%level) | %cyan(%logger{36}) - %highlight(%msg%n%ex{full})</pattern>
    </encoder>
  </appender>

  <root level="${LEVEL}">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="health.emrys.afon" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="ch.qos.logback" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="io.netty" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="net.snowflake" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="net.snowflake.client.jdbc.RestRequest" level="ERROR" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="org.apache.hc.client5" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
  <logger name="org.apache.polaris" level="${LEVEL}" additivity="false">
    <appender-ref ref="FILE_CORE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>
</configuration>
