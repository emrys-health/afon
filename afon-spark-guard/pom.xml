<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>health.emrys.afon</groupId>
        <artifactId>afon</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!-- Copied into the Spark image's /opt/spark/jars (see scripts/docker/spark-connect/Dockerfile), where the Spark Connect server
         loads its gRPC interceptor and its session extension.  Spark ships everything it needs but the JWT library, which is shaded
         into the jar, under a package of its own, so that it cannot clash with any copy of it that Spark's jars bring. -->
    <artifactId>afon-spark-guard</artifactId>

    <properties>
        <!-- Spark logs through log4j2, not the logback used elsewhere. -->
        <afon.slf4j />
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.compat.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The Spark Connect server, with its own copies of gRPC and protobuf, under org.sparkproject.connect, which an
             interceptor must be written against. -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-connect_${scala.compat.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.9.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.nimbusds:nimbus-jose-jwt</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.nimbusds</pattern>
                                    <shadedPattern>health.emrys.afon.spark.guard.shaded.nimbusds</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>com.nimbusds:nimbus-jose-jwt</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
