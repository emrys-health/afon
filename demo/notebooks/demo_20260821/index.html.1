    <div class="c-content-blocks__content col-innerblocks">
      <div class="c-innerblocks col-heading">
                  <span class="c-eyebrow text-eyebrow">What this changes</span>
                          <h2 class="text-page-title-lg">For patients, researchers and everyone</h2>
              </div>

          </div>

    <div class="c-innerblocks c-innerblocks--content-blocks">
<div
    class="c-icon-content col-innerblocks wp-block-icon-and-content"
  >
    <svg class="c-svg" width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
