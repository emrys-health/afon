<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>health.emrys</groupId>
        <artifactId>afon</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>afon-acceptance</artifactId>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-iceberg</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-infra</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>eks</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-polaris</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-spark</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>afon-trino</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-file-datalake</artifactId>
            <version>12.22.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.vertical-blank</groupId>
            <artifactId>sql-formatter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scala-lang.modules</groupId>
            <artifactId>scala-collection-compat_${scala.compat.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_${scala.compat.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.compat.version}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>aws</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Aws</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.None</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>aws-only</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Aws</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.Azure,health.emrys.afon.acceptance.tags.Gcp</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>azure</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Azure</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.None</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>azure-only</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Azure</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.Aws,health.emrys.afon.acceptance.tags.Gcp</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>gcp</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Gcp</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.None</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>gcp-only</id>
            <properties>
                <tagsToInclude>health.emrys.afon.acceptance.tags.Gcp</tagsToInclude>
                <tagsToExclude>health.emrys.afon.acceptance.tags.Aws,health.emrys.afon.acceptance.tags.Azure</tagsToExclude>
            </properties>
        </profile>
        <profile>
            <id>tags</id>
            <properties>
                <tagsToInclude></tagsToInclude>
                <tagsToExclude></tagsToExclude>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>net.alchim31.maven</groupId>
                        <artifactId>scala-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.scalatest</groupId>
                        <artifactId>scalatest-maven-plugin</artifactId>
                        <configuration>
                            <tagsToInclude>${tagsToInclude}</tagsToInclude>
                            <tagsToExclude>${tagsToExclude}</tagsToExclude>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>



</project>